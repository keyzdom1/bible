# Use your computer's LAN address when testing on a physical device.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
EXPO_PUBLIC_APP_URL=holyword://auth

# Cognito user pool for native sign-in. Leave blank for local development.
EXPO_PUBLIC_COGNITO_REGION=
EXPO_PUBLIC_COGNITO_CLIENT_ID=
EXPO_PUBLIC_COGNITO_DOMAIN=
EXPO_PUBLIC_COGNITO_REDIRECT_URI=holyword://auth

# Local identity provider. Disable for production builds.
EXPO_PUBLIC_AUTH_DEV_MODE=true
