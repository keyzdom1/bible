# HolyWord web API. Use an absolute URL in production.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local identity provider. Leave enabled for local development only.
NEXT_PUBLIC_AUTH_DEV_MODE=true

# Cognito user pool. Leave empty to hide hosted sign-in and registration.
NEXT_PUBLIC_COGNITO_REGION=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_REDIRECT_URI=http://localhost:3000/login
