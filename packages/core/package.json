{
  "name": "@holyword/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared types, verse references, content package schema and sync protocol for HolyWord",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1"
  }
}
