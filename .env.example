# Local development
DATABASE_URL=postgres://holyword:holyword@localhost:5432/holyword
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000

# API secrets (minimum 32 characters; required in production)
SESSION_SECRET=
DOWNLOAD_TOKEN_SECRET=

# Web session cookie
SESSION_COOKIE_NAME=holyword_session
SESSION_TTL_SECONDS=3600

# Download tickets issued by the API (seconds)
DOWNLOAD_TOKEN_TTL_SECONDS=300

# Cognito. Required in production; leave empty for local dev auth.
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local-only identity provider: accepts "dev:<email>" tokens.
# NEVER enable in production.
AUTH_DEV_MODE=true

# Comma-separated Cognito/admin email addresses allowed to use /v1/admin.
ADMIN_EMAILS=admin@example.com

# Content packages. The API reads immutable packages from this local mirror.
# Leave CONTENT_PACKAGE_DIR unset to use <repo>/content/packages; when setting it,
# use an absolute path or a path relative to the API process working directory.
# CONTENT_PACKAGE_DIR=C:/absolute/path/to/content/packages
#
# CONTENT_BASE_URL must include the API mount prefix (/v1/content). It is used only
# for locally signed package URLs; production tickets point at CloudFront instead.
CONTENT_BASE_URL=http://localhost:4000/v1/content
CONTENT_DELIVERY_MODE=local

# Optional deployment allow-list. A version is live only when its audited catalog
# row is enabled AND its id appears here. Leave empty to use the catalog flag alone.
VERSION_FLAGS=

# CloudFront signed delivery. Required when CONTENT_DELIVERY_MODE=cloudfront.
# CLOUDFRONT_CONTENT_URL is the distribution origin (no /v1/content suffix).
CLOUDFRONT_CONTENT_URL=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_PATH=
# Alternatively provide the PEM inline; escape newlines as \n.
CLOUDFRONT_PRIVATE_KEY=

# OpenSearch online search. When unset, search scans the local packages.
OPENSEARCH_URL=
OPENSEARCH_INDEX=holyword-verses
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_TIMEOUT_MS=2500

# AWS credentials for the content publishing CLI (pnpm content:publish).
AWS_REGION=us-east-1
